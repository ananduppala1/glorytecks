# ─────────────────────────────────────────────────────────────────────────────
# GloryTecks Admin Backend — environment variables
# Copy this file to `.env` (same folder) and fill in real values.
#   cp .env.example .env         (macOS/Linux)
#   copy .env.example .env       (Windows CMD)
#   Copy-Item .env.example .env  (Windows PowerShell)
#
# NEVER commit `.env`. Never put real keys in this file.
# ─────────────────────────────────────────────────────────────────────────────



# Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Project settings → API. For a local stack, `supabase start` prints these.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Public/anon key. Used ONLY to exchange email+password for a session at login;
# it carries no privileges of its own.
SUPABASE_ANON_KEY=

# SERVICE-ROLE KEY — SERVER-SIDE ONLY. Bypasses Row Level Security.
# Never expose it to a browser, never commit it, never return it from an API.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL — legacy HS256 JWT secret (Project settings → API → JWT Settings).
# When set, access tokens are verified in-process instead of with a network
# call to the Auth server on every request. Leave blank for projects using
# asymmetric signing keys; verification then goes through Supabase Auth.
SUPABASE_JWT_SECRET=

# ── Cookies ──────────────────────────────────────────────────────────────────
# The refresh token (issued by Supabase Auth) is stored in an httpOnly cookie.
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=dev_cookie_secret
# "true" only when frontend & backend are served over HTTPS (production)
COOKIE_SECURE=false
# Cross-site cookies require SameSite=none together with COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of admin-frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Public marketing-site origins. '*' allows any (fine for the read-only public API).
PUBLIC_CORS_ORIGINS=*

# ── Cloudinary (image/document uploads) — UNCHANGED BY THE MIGRATION ─────────
# Cloudinary remains the file store. Optional in dev; uploads are disabled
# until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=glorytecks

# ── Redis (response cache) — UNCHANGED BY THE MIGRATION ─────────────────────
# Optional: the app runs fine without Redis (caching is simply skipped).
# Set CACHE_ENABLED=false to disable cache entirely and avoid connection attempts.
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=gt:
CACHE_ENABLED=true

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Seed accounts (created by `npm run seed` / `npm run seed:admin`) ─────────
# These provision Supabase Auth identities AND their admin_users profiles.
# There is no public signup route — this is the only bootstrap path.
SEED_ADMIN_NAME=GloryTecks Admin
SEED_ADMIN_EMAIL=admin@glorytecks.com
SEED_ADMIN_PASSWORD=ChangeMe@12345

# Optional demo staff accounts (roles: receptionist, content_writer)
SEED_RECEPTIONIST_NAME=GloryTecks Reception
SEED_RECEPTIONIST_EMAIL=reception@glorytecks.com
SEED_RECEPTIONIST_PASSWORD=ChangeMe@12345
SEED_CONTENT_WRITER_NAME=GloryTecks Content
SEED_CONTENT_WRITER_EMAIL=content@glorytecks.com
SEED_CONTENT_WRITER_PASSWORD=ChangeMe@12345

# ── One-time data import only (npm run migrate:mongo) ───────────────────────
# Read-only source for the MongoDB → Supabase import script. The running API
# never reads this; remove it once the cutover is complete.
# MONGODB_URI=mongodb://127.0.0.1:27017/glorytecks

# ── File upload policy (Phase 1 hardening) ───────────────────────────────────
# Every value below has a secure default; set one only to change it.

# Per-file ceilings, and the smallest file considered real.
UPLOAD_IMAGE_MAX_BYTES=8388608
UPLOAD_DOC_MAX_BYTES=20971520
UPLOAD_MIN_BYTES=64

# Multipart shape limits, applied while the body is read.
UPLOAD_MAX_FILES=1
UPLOAD_MAX_FIELDS=8
UPLOAD_MAX_FIELD_SIZE_BYTES=4096
UPLOAD_MAX_FIELD_NAME_BYTES=100
UPLOAD_MAX_PARTS=12
UPLOAD_MAX_HEADER_PAIRS=50
UPLOAD_MAX_FILENAME_LENGTH=200

# Simultaneous in-flight uploads per process. multer buffers into memory, so
# this is what bounds peak RSS — raise it only alongside the instance's memory.
UPLOAD_MAX_CONCURRENT=6

# Format switches. SVG is executable markup and is OFF by default; when on,
# uploads are rejected unless provably inert (they are never rewritten).
UPLOAD_ALLOW_SVG=false
UPLOAD_ALLOW_GIF=true
UPLOAD_ALLOW_LEGACY_DOC=false
# Reject PDFs carrying JavaScript, launch actions or embedded files.
UPLOAD_REJECT_ACTIVE_PDF=true

# DOCX decompression-bomb guards.
UPLOAD_ZIP_MAX_ENTRIES=512
UPLOAD_ZIP_MAX_UNCOMPRESSED_BYTES=134217728
UPLOAD_ZIP_MAX_RATIO=200

# Allowed upload destinations (comma separated). Must cover every folder the
# admin UI sends — see tests/uploadStorage.test.ts, which asserts exactly that.
# UPLOAD_FOLDERS=images,documents,about,authors,avatars,blog,brand,brochures,companies,courses,gallery,hero,placements,testimonials,trainers

# Upload rate limit (per ACCOUNT, not per IP).

# Rate limit for the anonymous brochure download proxy (per IP).

# Hosts a stored media URL may point at. An entry may be an exact host or a
# leading-dot suffix wildcard (.example.com). The brochure proxy will only make
# an outbound request to a host on this list.
MEDIA_URL_HOSTS=res.cloudinary.com
# Set true only if legacy rows hold images on other hosts and editors cannot
# save them otherwise. Relaxes DISPLAY fields only: brochureUrl and fileUrl —
# the ones the server fetches — stay host-checked, as do all scheme rules.
MEDIA_ALLOW_ANY_HTTPS_HOST=false

# ── Rate limiting (Phase 4) ──────────────────────────────────────────────────
# Every threshold and window below is policy, not code. Tune per deployment.

# Proxies between the public internet and this app. THIS ONE MATTERS MOST.
# Too low: every request looks like it comes from the load balancer, so one
#          abusive client exhausts everyone's budget.
# Too high: the app trusts a client-supplied X-Forwarded-For, so an attacker
#          gets a fresh budget per forged address — a complete bypass.
# 1 = a single platform proxy (Vercel / Render / Railway / one nginx).
# 2 = behind Cloudflare AND a platform proxy.
# 0 = the app is directly exposed; forwarded headers are ignored entirely.
TRUST_PROXY_HOPS=1

# What happens when Redis is unreachable.
#   degrade (default) — fall back to per-process counters and log loudly. Limits
#                       stop being shared across instances but never disappear.
#   local             — always use per-process counters (single-instance, tests).
# There is deliberately no "fail open": losing Redis must not remove
# brute-force protection. There is also no "fail closed": that would turn a
# cache outage into a total authentication outage.
RATE_LIMIT_FAIL_MODE=degrade

# Global authenticated API ceiling, per address.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Sign-in. Three controls, because one is not enough:
#   authMax        failed attempts from one address
#   authAccountMax failed attempts against one email, from ANYWHERE
#                  (this is what a distributed credential-stuffing run hits)
#   authTotalMax   all attempts from one address, successes included
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AUTH_ACCOUNT_RATE_LIMIT_MAX=10
AUTH_TOTAL_RATE_LIMIT_MAX=60

# Progressive delay after repeated failures. A DELAY, not a lock: a lock would
# let anyone who knows an admin's address deny them service with one request.
# The streak expires on its own, so nothing ever needs an operator to clear it.
AUTH_BACKOFF_AFTER=3
AUTH_BACKOFF_BASE_MS=400
AUTH_BACKOFF_MAX_MS=8000
AUTH_BACKOFF_TTL_MS=1800000

# Refresh-token exchange, per address.
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=60

# Password change, per account.
PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RATE_LIMIT_MAX=10

# Uploads, per account (each buffers a file and costs provider storage).
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=60

# Public forms — the only writes an anonymous caller can reach.
PUBLIC_WRITE_RATE_LIMIT_WINDOW_MS=3600000
PUBLIC_WRITE_RATE_LIMIT_MAX=10

# Public reads. Set high on purpose: these are cached, idempotent, and every
# page of the marketing site depends on several. This is a flood ceiling, not a
# quota. Searches and deep pages miss the shared cache, so they spend a second,
# smaller budget as well.
PUBLIC_READ_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_READ_RATE_LIMIT_MAX=300
PUBLIC_SEARCH_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_SEARCH_RATE_LIMIT_MAX=30

# Anonymous endpoints that stream a file.
PUBLIC_DOWNLOAD_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_DOWNLOAD_RATE_LIMIT_MAX=60

# Authenticated writes, per account; and operations that copy records or
# provision accounts, which cost several times an ordinary write.
ADMIN_WRITE_RATE_LIMIT_WINDOW_MS=900000
ADMIN_WRITE_RATE_LIMIT_MAX=200
EXPENSIVE_RATE_LIMIT_WINDOW_MS=900000
EXPENSIVE_RATE_LIMIT_MAX=20
