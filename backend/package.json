{
  "name": "glorytecks-admin-backend",
  "version": "1.0.0",
  "description": "Production-grade CMS backend for the GloryTecks platform (Supabase PostgreSQL + Supabase Auth)",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --test --import tsx tests/*.test.ts",
    "seed": "tsx src/seed/seed.ts",
    "seed:admin": "tsx src/seed/createAdmin.ts",
    "migrate:mongo": "tsx src/scripts/migrate-mongodb-to-supabase.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "keywords": [
    "glorytecks",
    "cms",
    "admin",
    "express",
    "supabase",
    "postgresql"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "slugify": "^1.6.6",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "mongodb": "^6.12.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.1"
  }
}
