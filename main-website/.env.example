# ─────────────────────────────────────────────────────────────────────────────
# GloryTecks website — environment variables
#
# Copy to `.env.local` for local development, or set these in your host's
# dashboard (Vercel / Netlify / Railway) for production.
#
# NOTHING SECRET BELONGS IN THIS FILE. The website talks only to the public,
# unauthenticated endpoints of the GloryTecks Express backend. It never holds a
# Supabase service-role key, database credential or backend secret.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API ──────────────────────────────────────────────────────────────
# Base URL of the GloryTecks Express backend, including the /api/v1 prefix and
# with NO trailing slash.
#
# Browser-exposed on purpose: the contact form, the demo-request form and the
# brochure download link are submitted directly from the browser, exactly as in
# the React app. This URL is public information, not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Optional server-only override used by Server Components, generateMetadata,
# the sitemaps and robots.txt. Set this when the Next.js server can reach the
# backend over a private network address that the browser cannot use.
# Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
# API_BASE_URL=http://backend.internal:5000/api/v1

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical public origin, no trailing slash. Used for canonical URLs, Open
# Graph URLs, JSON-LD @id values, robots.txt and every sitemap.
#
# On the production Vercel environment this MUST be exactly
# https://glorytecks.com. Any other valid origin — a *.vercel.app alias
# included — is baked into every canonical at build time and turns robots.txt
# into `Disallow: /`. Inlined at build, so a change needs a redeploy. Verify a
# deployment with `SEO_SMOKE_BASE_URL=<its url> npm run test:smoke`.
NEXT_PUBLIC_SITE_URL=https://glorytecks.com

# ── Images ───────────────────────────────────────────────────────────────────
# Extra image hosts to allow through next/image, comma-separated.
# res.cloudinary.com is always allowed. Any host not on the list still renders
# correctly — it simply bypasses Next.js image optimisation.
# NEXT_PUBLIC_IMAGE_HOSTS=images.example.com,cdn.example.com

# ── ISR / revalidation (seconds) ─────────────────────────────────────────────
# Defaults mirror the backend's own Redis TTLs and Cache-Control tiers.
# Leave unset unless you need to tune freshness.
# REVALIDATE_FAST=60      # settings, about, batches, testimonials, … (editor-facing)
# REVALIDATE_CONTENT=300  # blogs, courses (high-volume, slower-changing)
